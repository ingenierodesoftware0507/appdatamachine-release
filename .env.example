# Copie este archivo como ".env" (en la misma carpeta que main.js) y complete los valores.
# Todas las variables son obligatorias: si falta alguna el servidor no arranca.

# Puerto HTTP en el que escucha appdatamachine (el mismo que se ingresa como URL del servidor en AppData)
PORT=3000

# Tableros de gases (Modbus TCP, puerto 502)
IPTABLEROGASESMIXTA=
IPTABLEROGASESMOTOS=

# Tablero de opacidad
IPTABLEROOPA=

# Luxómetros (servidor TCP que levanta appdatamachine: IP local y puerto)
IPLUXOEMTROMIXTA=
PUERTOLUXOMETROMIXTA=
IPLUXOMETROMOTOS=
PUERTOLUXOMETROMOTOS=

# Modo puente (opcional): IP y puerto del luxómetro REAL. Si se llenan, la app se
# conecta a appdatamachine (IP/puerto de arriba) y este reenvía todo al equipo real,
# permitiendo además inyectar tramas simuladas. Vacío = solo simulador.
# Si el puerto real se deja vacío se usa el mismo puerto de arriba.
IPLUXOMETROREALMIXTA=
PUERTOLUXOMETROREALMIXTA=
IPLUXOMETROREALMOTOS=
PUERTOLUXOMETROREALMOTOS=

# Frenómetros
IPFRENOMETROMIXTA=
IPFRENOMETROMOTOS=

# Taxímetro
IPTAXIMETRO=

# Sonómetros
IPSONOMETROMIXTA=
IPSONOMETROMOTOS=
